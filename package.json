{
  "name": "magical-steps",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "images:optimize": "node scripts/optimize-all.mjs",
    "images:hero": "node scripts/prepare-hero-media.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:lighthouse": "node scripts/audit-lighthouse.mjs",
    "test:journey": "node --test scripts/test-journey.mjs",
    "content:refine": "python3 scripts/prepare-journey-content.py && python3 scripts/refine-content.py && python3 scripts/review-turkish-programs.py && python3 scripts/check-inclusion-conflicts.py",
    "images:responsive": "node scripts/prepare-responsive-images.mjs",
    "test:media": "node --test scripts/test-responsive-media.mjs"
  },
  "dependencies": {
    "motion": "14.12.0",
    "next": "16.4.6",
    "next-intl": "4.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13",
    "prettier": "^3.9.10",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
